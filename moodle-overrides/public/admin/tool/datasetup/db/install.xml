<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/datasetup/db" VERSION="2026071001" COMMENT="XMLDB file for Moodle tool_datasetup"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="tool_datasetup_school" COMMENT="School master setup records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="trust_code" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="trust_name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="school_code" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="school_name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="udise_code" TYPE="char" LENGTH="11" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="affiliation_no" TYPE="char" LENGTH="80" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="school_type" TYPE="char" LENGTH="80" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="address_line1" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="address_line2" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="city" TYPE="char" LENGTH="120" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="district" TYPE="char" LENGTH="120" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="state" TYPE="char" LENGTH="120" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="pincode" TYPE="char" LENGTH="6" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="phone" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="email" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="website" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="principal_username" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="academic_year" TYPE="char" LENGTH="9" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="schoolyear_uix" UNIQUE="true" FIELDS="school_code, academic_year"/>
        <INDEX NAME="email_uix" UNIQUE="true" FIELDS="email"/>
        <INDEX NAME="trust_idx" UNIQUE="false" FIELDS="trust_code"/>
        <INDEX NAME="state_year_idx" UNIQUE="false" FIELDS="state, academic_year"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_datasetup_module" COMMENT="Workbook sheet modules exposed by the dataset setup tool">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sheet_name" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="module_group" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="source_csv" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="ordered_csv" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="purpose" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="required" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="standard_prefilled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="header_row" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="5" SEQUENCE="false"/>
        <FIELD NAME="example_row" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="6" SEQUENCE="false"/>
        <FIELD NAME="data_start_row" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="7" SEQUENCE="false"/>
        <FIELD NAME="column_count" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="columns_json" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sort_order" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sheetname_uix" UNIQUE="true" FIELDS="sheet_name"/>
        <INDEX NAME="group_order_idx" UNIQUE="false" FIELDS="module_group, sort_order"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_datasetup_record" COMMENT="Rows imported or created for workbook sheet modules">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="moduleid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="row_number" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="row_key" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="row_hash" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="row_data" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="search_text" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="validation_state" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="valid" SEQUENCE="false"/>
        <FIELD NAME="validation_errors" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="modulefk" TYPE="foreign" FIELDS="moduleid" REFTABLE="tool_datasetup_module" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="module_row_idx" UNIQUE="false" FIELDS="moduleid, row_number"/>
        <INDEX NAME="module_status_idx" UNIQUE="false" FIELDS="moduleid, status"/>
        <INDEX NAME="module_hash_idx" UNIQUE="false" FIELDS="moduleid, row_hash"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>

{{!
    @template theme_custom_lms/partials/student_course_overview

    Permission-safe student course overview built from live Moodle course data.
}}
<section class="custom-lms-student-course-hero" aria-labelledby="page-heading">
    <div class="custom-lms-student-course-hero-main">
        {{{ output.full_header }}}

        {{#studentcourse_has_summary}}
            <p class="custom-lms-student-course-lead">{{studentcourse_summary_plain}}</p>
        {{/studentcourse_has_summary}}
        {{^studentcourse_has_summary}}
            <p class="custom-lms-student-course-lead">
                {{#str}}studentcoursekeepgoing, theme_custom_lms{{/str}}
            </p>
        {{/studentcourse_has_summary}}

        <div class="custom-lms-student-course-progress-line">
            <div class="custom-lms-student-course-progress-copy">
                <span>{{#str}}studentcourseprogress, theme_custom_lms{{/str}}</span>
                <strong>{{studentcourse_progress}}%</strong>
            </div>
            <div class="progress" role="progressbar" aria-label="{{#str}}studentcourseprogress, theme_custom_lms{{/str}}" aria-valuenow="{{studentcourse_progress}}" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: {{studentcourse_progress}}%"></div>
            </div>
        </div>
    </div>

    <div class="custom-lms-student-course-hero-media" aria-hidden="true">
        <span class="custom-lms-student-course-media-window custom-lms-student-course-media-window-top"></span>
        <span class="custom-lms-student-course-media-window custom-lms-student-course-media-window-bottom"></span>
        <img src="{{studentcourse_course_image}}" alt="" loading="eager">
    </div>

</section>

<section class="custom-lms-student-course-summary-card" aria-labelledby="custom-lms-course-summary-title">
    <h2 id="custom-lms-course-summary-title">{{#str}}studentcoursecoursesummary, theme_custom_lms{{/str}}</h2>
    <dl class="custom-lms-student-course-summary-grid">
        <div class="custom-lms-student-course-summary-item custom-lms-student-course-summary-teacher">
            {{#studentcourse_has_teacher_picture}}
                {{{studentcourse_teacher_picture}}}
            {{/studentcourse_has_teacher_picture}}
            {{^studentcourse_has_teacher_picture}}
                <span class="custom-lms-student-course-avatar" aria-hidden="true">{{studentcourse_teacher_initials}}</span>
            {{/studentcourse_has_teacher_picture}}
            <span>
                <dt>{{#str}}studentcourseinstructor, theme_custom_lms{{/str}}</dt>
                <dd>{{studentcourse_teacher_name}}</dd>
            </span>
        </div>

        {{#studentcourse_can_view_participants}}
            <div class="custom-lms-student-course-summary-item">
                <span class="custom-lms-student-course-summary-icon" aria-hidden="true"><i class="fa fa-users"></i></span>
                <span>
                    <dt>{{#str}}studentcourseenrolledstudents, theme_custom_lms{{/str}}</dt>
                    <dd>{{studentcourse_enrolled_count}}</dd>
                </span>
            </div>
        {{/studentcourse_can_view_participants}}

        {{#studentcourse_has_start_date}}
            <div class="custom-lms-student-course-summary-item">
                <span class="custom-lms-student-course-summary-icon" aria-hidden="true"><i class="fa fa-calendar"></i></span>
                <span>
                    <dt>{{#str}}studentcoursestartdate, theme_custom_lms{{/str}}</dt>
                    <dd>{{studentcourse_start_date}}</dd>
                </span>
            </div>
        {{/studentcourse_has_start_date}}

        {{#studentcourse_has_end_date}}
            <div class="custom-lms-student-course-summary-item">
                <span class="custom-lms-student-course-summary-icon" aria-hidden="true"><i class="fa fa-calendar-check-o"></i></span>
                <span>
                    <dt>{{#str}}studentcourseenddate, theme_custom_lms{{/str}}</dt>
                    <dd>{{studentcourse_end_date}}</dd>
                </span>
            </div>
        {{/studentcourse_has_end_date}}
    </dl>
</section>

{{#studentcourse_has_summary}}
    <section class="custom-lms-student-course-about" aria-labelledby="custom-lms-course-about-title">
        <h2 id="custom-lms-course-about-title">{{#str}}studentcourseabout, theme_custom_lms{{/str}}</h2>
        <div class="custom-lms-student-course-about-copy">{{{studentcourse_summary}}}</div>
        <dl class="custom-lms-student-course-facts">
            {{#studentcourse_has_category}}
                <div>
                    <dt>{{#str}}category, core{{/str}}</dt>
                    <dd>{{studentcourse_category}}</dd>
                </div>
            {{/studentcourse_has_category}}
            <div>
                <dt>{{#str}}studentcoursesections, theme_custom_lms{{/str}}</dt>
                <dd>{{studentcourse_section_count}}</dd>
            </div>
            <div>
                <dt>{{#str}}studentcourseactivities, theme_custom_lms{{/str}}</dt>
                <dd>{{studentcourse_activity_count}}</dd>
            </div>
            {{#studentcourse_has_duration}}
                <div>
                    <dt>{{#str}}studentcourseduration, theme_custom_lms{{/str}}</dt>
                    <dd>{{studentcourse_duration_label}}</dd>
                </div>
            {{/studentcourse_has_duration}}
        </dl>
    </section>
{{/studentcourse_has_summary}}

{{! @template theme_custom_lms/pages/role_login }}
<main class="role-picker page-transition"><header class="role-header"><img alt="{{schoolname}} logo" src="{{{pix_school_logo}}}"/><div><span class="eyebrow">Secure role-based access</span><h1>Choose your login experience</h1><p>Select a role to preview its distinct colour identity. Authentication remains a single secure Moodle flow.</p></div><a class="button ghost public-cta" href="{{{url_public_home}}}" style="margin-left:auto">Explore public site</a></header><section aria-label="Login roles" class="role-grid"><article class="role-card role-card-teacher"><div class="role-top" data-icon="👩‍🏫"><strong>Teacher</strong><h2>Teacher login</h2></div><div class="role-body"><p class="muted">Manage classes, grade work and review learning analytics.</p><ul class="role-features"><li>Course management</li><li>Grading and feedback</li><li>Learning analytics</li></ul><a class="button" href="{{{url_login_teacher}}}">Continue as Teacher <span aria-hidden="true">→</span></a></div></article><article class="role-card role-card-student"><div class="role-top" data-icon="🎓"><strong>Student</strong><h2>Student login</h2></div><div class="role-body"><p class="muted">Access courses, activities, grades and progress.</p><ul class="role-features"><li>Personal courses</li><li>Progress tracking</li><li>Achievements</li></ul><a class="button" href="{{{url_login_student}}}">Continue as Student <span aria-hidden="true">→</span></a></div></article><article class="role-card role-card-admin"><div class="role-top" data-icon="⚙️"><strong>Site administrator</strong><h2>Administrator login</h2></div><div class="role-body"><p class="muted">Configure users, courses, plugins and reports.</p><ul class="role-features"><li>Site configuration</li><li>User management</li><li>System reports</li></ul><a class="button" href="{{{url_login_admin}}}">Continue as Site administrator <span aria-hidden="true">→</span></a></div></article><article class="role-card role-card-parent"><div class="role-top" data-icon="👨‍👩‍👧"><strong>Parent / guardian</strong><h2>Parent login</h2></div><div class="role-body"><p class="muted">Track attendance, progress and school communication.</p><ul class="role-features"><li>Linked learner progress</li><li>School communication</li><li>Calendar and notices</li></ul><a class="button" href="{{{url_login_parent}}}">Continue as Parent / guardian <span aria-hidden="true">→</span></a></div></article><article class="role-card role-card-participant"><div class="role-top" data-icon="🤝"><strong>Other participant</strong><h2>Participant login</h2></div><div class="role-body"><p class="muted">Join approved learning spaces and collaborative activities.</p><ul class="role-features"><li>Approved courses</li><li>Collaboration</li><li>Shared resources</li></ul><a class="button" href="{{{url_login_participant}}}">Continue as Other participant <span aria-hidden="true">→</span></a></div></article></section></main>{{> theme_custom_lms/partials/global_mini_footer }}

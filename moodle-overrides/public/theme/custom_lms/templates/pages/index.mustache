{{! @template theme_custom_lms/pages/index }}
<div class="student-portal-layout">
                <div class="student-portal-center">
                    <section class="student-portal-welcome student-portal-welcome-slider"
                             aria-label="Student dashboard highlights"
                             aria-roledescription="carousel"
                             data-student-welcome-slider
                             tabindex="0">
                        <div class="student-portal-welcome-track" aria-live="off">
                            <article class="student-portal-welcome-slide active"
                                     data-student-welcome-slide
                                     id="student-welcome-slide-1"
                                     aria-hidden="false">
                                <img alt="" src="{{{pix_school_logo}}}">
                                <div>
                                    <h1 id="student-welcome-heading">Welcome back, {{userfirstname}}!</h1>
                                    <p>Keep up the great work and continue your journey of learning and growth.</p>
                                </div>
                                <i aria-hidden="true" class="fa fa-university"></i>
                            </article>
                            <article class="student-portal-welcome-slide"
                                     data-student-welcome-slide
                                     id="student-welcome-slide-2"
                                     aria-hidden="true">
                                <img alt="" src="{{{pix_school_logo}}}">
                                <div>
                                    <h2>{{enrolledcoursecount}} courses in your learning plan</h2>
                                    <p>Your overall course progress is {{overallprogress}}%. Continue where you left off.</p>
                                </div>
                                <i aria-hidden="true" class="fa fa-graduation-cap"></i>
                            </article>
                            <article class="student-portal-welcome-slide"
                                     data-student-welcome-slide
                                     id="student-welcome-slide-3"
                                     aria-hidden="true">
                                <img alt="" src="{{{pix_school_logo}}}">
                                <div>
                                    <h2>{{completedactivitycount}} activities completed</h2>
                                    <p>{{pendingactivitycount}} learning activities are ready for your next study session.</p>
                                </div>
                                <i aria-hidden="true" class="fa fa-check-circle-o"></i>
                            </article>
                            <article class="student-portal-welcome-slide"
                                     data-student-welcome-slide
                                     id="student-welcome-slide-4"
                                     aria-hidden="true">
                                <img alt="" src="{{{pix_school_logo}}}">
                                <div>
                                    <h2>Stay on track this week</h2>
                                    <p>Review your calendar, upcoming activities and announcements before your next lesson.</p>
                                </div>
                                <i aria-hidden="true" class="fa fa-calendar-check-o"></i>
                            </article>
                        </div>
                        <div class="student-portal-welcome-dots" aria-label="Choose dashboard highlight">
                            <button class="active" type="button" data-student-welcome-dot data-slide="0"
                                    aria-controls="student-welcome-slide-1" aria-current="true">
                                <span class="visually-hidden">Welcome message</span>
                            </button>
                            <button type="button" data-student-welcome-dot data-slide="1"
                                    aria-controls="student-welcome-slide-2" aria-current="false">
                                <span class="visually-hidden">Learning plan summary</span>
                            </button>
                            <button type="button" data-student-welcome-dot data-slide="2"
                                    aria-controls="student-welcome-slide-3" aria-current="false">
                                <span class="visually-hidden">Activity completion summary</span>
                            </button>
                            <button type="button" data-student-welcome-dot data-slide="3"
                                    aria-controls="student-welcome-slide-4" aria-current="false">
                                <span class="visually-hidden">Weekly planning reminder</span>
                            </button>
                        </div>
                    </section>

                    <section class="student-portal-courses" aria-labelledby="student-courses-heading">
                        <div class="student-portal-section-heading">
                            <h2 id="student-courses-heading">My courses</h2>
                            <a href="{{{url_my_courses}}}">View all <i aria-hidden="true" class="fa fa-angle-right"></i></a>
                        </div>
                        {{#hasdashboardcourses}}
                            <div class="student-dashboard-course-grid">
                                {{#dashboardcourses}}
                                    {{> theme_custom_lms/partials/student_dashboard_course_card }}
                                {{/dashboardcourses}}
                            </div>
                        {{/hasdashboardcourses}}
                        {{^hasdashboardcourses}}
                            <div class="student-portal-empty"><i aria-hidden="true" class="fa fa-book"></i><p>Courses assigned to your account will appear here.</p></div>
                        {{/hasdashboardcourses}}
                    </section>

                    <section aria-label="Learning statistics" class="student-portal-stats">
                        <article><i aria-hidden="true" class="fa fa-book"></i><strong>{{enrolledcoursecount}}</strong><span>Courses<br>enrolled</span></article>
                        <article><i aria-hidden="true" class="fa fa-check-circle-o"></i><strong>{{completedactivitycount}}</strong><span>Activities<br>completed</span></article>
                        <article><i aria-hidden="true" class="fa fa-clock-o"></i><strong>{{pendingactivitycount}}</strong><span>Activities<br>pending</span></article>
                        <article><i aria-hidden="true" class="fa fa-line-chart"></i><strong>{{overallprogress}}%</strong><span>Overall<br>progress</span></article>
                    </section>

                    {{#firstcourse}}
                    <section class="student-portal-continue" aria-labelledby="student-continue-heading">
                        <div class="student-portal-section-heading">
                            <h2 id="student-continue-heading">Continue learning</h2>
                            <a href="{{{url_my_courses}}}">View all <i aria-hidden="true" class="fa fa-angle-right"></i></a>
                        </div>
                        <div class="student-portal-continue-body">
                            <a class="student-portal-continue-media" href="{{{courseurl}}}"><img alt="" src="{{{coverurl}}}"><i aria-hidden="true" class="fa fa-play"></i></a>
                            <div>
                                <h3>{{fullname}}</h3>
                                <p>{{shortname}}</p>
                                <div class="student-dashboard-course-meter"><span style="{{progressstyle}}"></span></div>
                                <a class="student-portal-continue-button" href="{{{courseurl}}}">Continue learning</a>
                            </div>
                            <strong>{{progress}}%</strong>
                        </div>
                    </section>
                    {{/firstcourse}}
                </div>

                <aside class="student-portal-right-rail">
                    <section class="student-portal-profile-card">
                        <div class="student-portal-profile-heading">
                            <span class="student-portal-profile-avatar">{{{userpicture}}}</span>
                            <div class="student-portal-profile-identity">
                                <h2>{{userfullname}}</h2>
                                <p><i aria-hidden="true" class="fa fa-graduation-cap"></i>{{rolelabel}}</p>
                                <b><i aria-hidden="true" class="fa fa-star"></i>Level {{enrolledcoursecount}}</b>
                            </div>
                            <span class="student-portal-profile-schoolmark">
                                <img alt="{{schoolname}} logo" src="{{{pix_school_logo}}}">
                            </span>
                        </div>
                        <div class="student-portal-profile-progress">
                            <div class="student-portal-profile-progress-heading">
                                <strong><i aria-hidden="true" class="fa fa-line-chart"></i>Your progress</strong>
                                <span><i aria-hidden="true" class="fa fa-arrow-up"></i>Keep going!</span>
                            </div>
                            <div class="student-portal-profile-progress-meter">
                                <div class="student-dashboard-course-meter" role="progressbar" aria-label="Your progress" aria-valuenow="{{overallprogress}}" aria-valuemin="0" aria-valuemax="100"><span style="{{overallprogressstyle}}"></span></div>
                                <b>{{overallprogress}}%</b>
                            </div>
                            <p><i aria-hidden="true" class="fa fa-lightbulb-o"></i>Keep it up and achieve more.</p>
                        </div>
                    </section>

                    <section class="student-portal-events">
                        <div class="student-portal-section-heading"><h2>Upcoming events</h2><i aria-hidden="true" class="fa fa-calendar"></i></div>
                        {{#hasupcomingevents}}
                            <ul>
                            {{#upcomingevents}}
                                <li><a href="{{{url}}}"><time datetime=""><b>{{month}}</b><strong>{{day}}</strong></time><span><strong>{{name}}</strong><small>{{course}}</small><em>{{timelabel}}</em></span></a></li>
                            {{/upcomingevents}}
                            </ul>
                        {{/hasupcomingevents}}
                        {{^hasupcomingevents}}<p class="student-portal-empty-copy">No upcoming events in the next 45 days.</p>{{/hasupcomingevents}}
                        <a class="student-portal-panel-link" href="{{{url_moodle_calendar}}}">View calendar <i aria-hidden="true" class="fa fa-angle-right"></i></a>
                    </section>

                    <section class="student-portal-announcements">
                        <div class="student-portal-section-heading"><h2><i aria-hidden="true" class="fa fa-bullhorn"></i> Latest announcements</h2></div>
                        {{#haslatestannouncement}}
                            {{#latestannouncement}}<a href="{{{url}}}"><strong>{{title}}</strong><span>{{course}} · {{date}}</span><i aria-hidden="true" class="fa fa-angle-right"></i></a>{{/latestannouncement}}
                        {{/haslatestannouncement}}
                        {{^haslatestannouncement}}<p class="student-portal-empty-copy">No course announcements are available.</p>{{/haslatestannouncement}}
                    </section>
                </aside>
</div>

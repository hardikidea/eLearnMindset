{{! @template theme_custom_lms/pages/my_courses }}
<div class="course-overview-page student-portal-my-courses">
    <header class="student-my-courses-heading">
        <div>
            <span class="student-section-kicker"><i aria-hidden="true" class="fa fa-graduation-cap"></i> Learning workspace</span>
            <h1>My courses</h1>
            <p>Find, filter and continue every learning pathway assigned to your account.</p>
        </div>
        <div class="student-my-courses-overall">
            <span>Overall progress</span>
            <strong>{{overallprogress}}%</strong>
            <div aria-label="{{overallprogress}}% overall progress" aria-valuemax="100" aria-valuemin="0"
                    aria-valuenow="{{overallprogress}}" class="student-dashboard-course-meter" role="progressbar">
                <span style="{{overallprogressstyle}}"></span>
            </div>
        </div>
    </header>

    <section aria-label="Course status summary" class="student-my-courses-stats">
        <article><i aria-hidden="true" class="fa fa-book"></i><span><strong>{{enrolledcoursecount}}</strong>Total courses</span></article>
        <article><i aria-hidden="true" class="fa fa-play-circle-o"></i><span><strong>{{inprogresscoursecount}}</strong>In progress</span></article>
        <article><i aria-hidden="true" class="fa fa-check-circle-o"></i><span><strong>{{completedcoursecount}}</strong>Completed</span></article>
        <article><i aria-hidden="true" class="fa fa-clock-o"></i><span><strong>{{notstartedcoursecount}}</strong>Not started</span></article>
    </section>

    <section class="student-course-library" aria-labelledby="course-overview-heading">
        <div class="student-course-library-heading">
            <div>
                <h2 id="course-overview-heading">Course overview</h2>
                <p>{{enrolledcoursecount}} courses assigned to your learning plan</p>
            </div>
        </div>
        <div class="course-toolbar" role="search">
            <label class="course-search">
                <span aria-hidden="true" class="search-icon"><i class="fa fa-search"></i></span>
                <input aria-label="Filter displayed courses" data-course-search placeholder="Search courses" type="search">
            </label>
            <div aria-label="Course display" class="view-switch" role="group">
                <button aria-label="Grid view" aria-pressed="true" class="active" data-course-view="grid" type="button"><i aria-hidden="true" class="fa fa-th-large"></i></button>
                <button aria-label="List view" aria-pressed="false" data-course-view="list" type="button"><i aria-hidden="true" class="fa fa-list"></i></button>
                <button aria-label="Compact view" aria-pressed="false" data-course-view="summary" type="button"><i aria-hidden="true" class="fa fa-th"></i></button>
            </div>
        </div>

        {{#hascourses}}
            <div class="course-card-grid" data-course-grid>
                {{#courses}}
                    {{> theme_custom_lms/partials/course_overview_card }}
                {{/courses}}
            </div>
        {{/hascourses}}
        {{^hascourses}}
            <div class="student-portal-empty">
                <i aria-hidden="true" class="fa fa-book"></i>
                <p>You are not enrolled in any visible courses.</p>
            </div>
        {{/hascourses}}
        <p class="student-course-search-empty" data-course-search-empty hidden>No courses match your search.</p>
    </section>
</div>

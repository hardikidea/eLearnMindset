{{! @template theme_custom_lms/pages/login }}
<main class="page-transition role-picker"><header class="role-header"><img alt="Logo" src="{{{pix_school_logo}}}"/><div><span class="eyebrow">Secure role-based access</span><h1>Choose your login experience</h1><p>Each role opens a distinct colour theme while preserving the same responsive flex-layout foundation.</p></div><a class="button ghost" href="{{{url_public_home}}}" style="margin-left:auto">Public site</a></header><section class="role-grid"><article class="role-card role-card-teacher"><div class="role-top"><strong>Teacher</strong><h2>Teacher login</h2></div><div class="role-body"><p class="muted">Manage classes, grade work and review learning analytics.</p><a class="button" href="{{{url_login_teacher}}}">Continue as Teacher</a></div></article><article class="role-card role-card-student"><div class="role-top"><strong>Student</strong><h2>Student login</h2></div><div class="role-body"><p class="muted">Access courses, activities, grades and progress.</p><a class="button" href="{{{url_login_student}}}">Continue as Student</a></div></article><article class="role-card role-card-admin"><div class="role-top"><strong>Site administrator</strong><h2>Site administrator login</h2></div><div class="role-body"><p class="muted">Configure users, courses, plugins and reports.</p><a class="button" href="{{{url_login_admin}}}">Continue as Site administrator</a></div></article><article class="role-card role-card-parent"><div class="role-top"><strong>Parent / guardian</strong><h2>Parent / guardian login</h2></div><div class="role-body"><p class="muted">Track attendance, progress and school communication.</p><a class="button" href="{{{url_login_parent}}}">Continue as Parent / guardian</a></div></article><article class="role-card role-card-participant"><div class="role-top"><strong>Other participant</strong><h2>Other participant login</h2></div><div class="role-body"><p class="muted">Join approved learning spaces and collaborative activities.</p><a class="button" href="{{{url_login_participant}}}">Continue as Other participant</a></div></article></section></main>{{> theme_custom_lms/partials/global_mini_footer }}

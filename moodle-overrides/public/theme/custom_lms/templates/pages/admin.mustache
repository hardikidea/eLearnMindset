iv><img alt="School logo" src="{{{pix_school_logo}}}"/></section><div class="grid"><article class="card"><div class="icon-card">1</div><h3>Users</h3><p class="muted">5,240 accounts  |  42 online</p><a href="{{{url_users}}}">Open -&gt;</a></article><article class="card"><div class="icon-card">2</div><h3>Courses</h3><p class="muted">318 active courses</p><a href="{{{url_courses_admin}}}">Open -&gt;</a></article><article class="card"><div class="icon-card">3</div><h3>System health</h3><p class="muted">All scheduled tasks operational</p><a href="{{{url_logs}}}">Open -&gt;</a></article></div></main></section></div>{{> theme_custom_lms/partials/global_mini_footer }}

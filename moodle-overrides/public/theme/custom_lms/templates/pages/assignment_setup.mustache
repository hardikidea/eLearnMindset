{{! @template theme_custom_lms/pages/assignment_setup }}
<div class="app"><aside class="sidebar"><div class="brand"><img alt="{{schoolname}} logo" src="{{{pix_school_logo}}}"/><div><strong>{{schoolname}}</strong><small>{{moodleversionlabel}}</small></div></div><nav class="nav"><a class="" href="{{{url_index}}}"><span class="icon">H</span><span>Dashboard</span></a><a class="" href="{{{url_site_home}}}"><span class="icon">O</span><span>Site home</span></a><a class="active" href="{{{url_my_courses}}}"><span class="icon">C</span><span>My courses</span></a><a class="" href="{{{url_course_player}}}"><span class="icon">P</span><span>Course player</span></a><a class="" href="{{{url_calendar}}}"><span class="icon">K</span><span>Calendar</span></a><a class="" href="{{{url_grades}}}"><span class="icon">G</span><span>Grades</span></a><a class="" href="{{{url_messages}}}"><span class="icon">M</span><span>Messages</span></a><a class="" href="{{{url_notifications}}}"><span class="icon">N</span><span>Notifications</span></a><a class="" href="{{{url_profile}}}"><span class="icon">U</span><span>Profile</span></a><a class="" href="{{{url_settings}}}"><span class="icon">S</span><span>Settings</span></a></nav><div class="sidebar-foot">Role theme: Teacher<br/>Responsive flex layout</div></aside><section class="main"><header class="topbar"><button aria-label="Open navigation" class="menu secondary">Menu</button><div class="search"><input aria-label="Search" placeholder="Search courses, activities, resources..."/></div><div class="user-mini"><div class="avatar-sm">{{userinitials}}</div><div><strong>{{userfullname}}</strong><small>{{rolelabel}}</small></div></div></header><main class="content page-transition"><h1>Assignment settings</h1><section class="panel"><div class="form-grid"><div class="field"><label>Assignment name</label><input value="Perspectives in Psychology"/></div><div class="field"><label>Maximum grade</label><input value="20"/></div><div class="field"><label>Due date</label><input type="datetime-local"/></div><div class="field"><label>Submission type</label><select><option>File submissions</option><option>Online text</option></select></div></div><label style="display:block;margin-top:16px"><b>Description</b></label><textarea rows="7"></textarea><button style="margin-top:16px">Save and display</button></section></main></section></div>{{> theme_custom_lms/partials/global_mini_footer }}

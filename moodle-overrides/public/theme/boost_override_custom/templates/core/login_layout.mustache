                        <strong>Daily visibility</strong>
                    </article>
                    <article class="boc-login-feature-card boc-feature-parent">
                        <svg class="boc-login-svg-icon boc-login-feature-svg" aria-hidden="true" focusable="false"><use href="#bocIconParent"></use></svg>
                        <h3>Parent view</h3>
                        <p>Share progress snapshots without exposing admin tools.</p>
                        <strong>{{boclogin.stats.parents.value}} parent users</strong>
                    </article>
                    <article class="boc-login-feature-card boc-feature-notice">
                        <svg class="boc-login-svg-icon boc-login-feature-svg" aria-hidden="true" focusable="false"><use href="#bocIconNotice"></use></svg>
                        <h3>Announcements</h3>
                        <p>Keep notices, forums and course updates connected.</p>
                        <strong>{{boclogin.stats.forums.value}} forums</strong>
                    </article>
                    <article class="boc-login-feature-card boc-feature-calendar">
                        <svg class="boc-login-svg-icon boc-login-feature-svg" aria-hidden="true" focusable="false"><use href="#bocIconCalendar"></use></svg>
                        <h3>Academic calendar</h3>
                        <p>Plan terms, lessons, due dates and events together.</p>
                        <strong>2026 session</strong>
                    </article>
                    <article class="boc-login-feature-card boc-feature-secure">
                        <svg class="boc-login-svg-icon boc-login-feature-svg" aria-hidden="true" focusable="false"><use href="#bocIconSecure"></use></svg>
                        <h3>Secure access</h3>
                        <p>Use Moodle session protection and role permissions.</p>
                        <strong>{{boclogin.stats.enrolments.value}} enrolments</strong>
                    </article>
                </div>
            </div>
        </div>
    </section>
</div>

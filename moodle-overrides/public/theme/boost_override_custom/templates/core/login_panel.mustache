            <button type="button" data-boc-login-dot aria-label="Show teacher workspace slide" aria-selected="false"></button>
            <button type="button" data-boc-login-dot aria-label="Show parent connect slide" aria-selected="false"></button>
            <button type="button" data-boc-login-dot aria-label="Show course catalogue slide" aria-selected="false"></button>
            <button type="button" data-boc-login-dot aria-label="Show interactive activities slide" aria-selected="false"></button>
            <button type="button" data-boc-login-dot aria-label="Show assessment engine slide" aria-selected="false"></button>
            <button type="button" data-boc-login-dot aria-label="Show grade system slide" aria-selected="false"></button>
            <button type="button" data-boc-login-dot aria-label="Show certificates slide" aria-selected="false"></button>
            <button type="button" data-boc-login-dot aria-label="Show communication slide" aria-selected="false"></button>
        </div>
    </section>

    <section class="boc-login-role-grid" aria-label="Live role counts">
        <article class="boc-login-role-card boc-role-users">
            <span><svg class="boc-login-svg-icon boc-login-role-icon" aria-hidden="true" focusable="false"><use href="#bocIconUsers"></use></svg></span>
            <strong data-boc-count="{{boclogin.stats.users.raw}}">{{boclogin.stats.users.value}}</strong>
            <small>active users</small>
        </article>
        <article class="boc-login-role-card boc-role-students">
            <span><svg class="boc-login-svg-icon boc-login-role-icon" aria-hidden="true" focusable="false"><use href="#bocIconStudent"></use></svg></span>
            <strong data-boc-count="{{boclogin.stats.students.raw}}">{{boclogin.stats.students.value}}</strong>
            <small>students</small>
        </article>
        <article class="boc-login-role-card boc-role-teachers">
            <span><svg class="boc-login-svg-icon boc-login-role-icon" aria-hidden="true" focusable="false"><use href="#bocIconTeacher"></use></svg></span>
            <strong data-boc-count="{{boclogin.stats.teachers.raw}}">{{boclogin.stats.teachers.value}}</strong>
            <small>teachers</small>
        </article>
        <article class="boc-login-role-card boc-role-parents">
            <span><svg class="boc-login-svg-icon boc-login-role-icon" aria-hidden="true" focusable="false"><use href="#bocIconParent"></use></svg></span>
            <strong data-boc-count="{{boclogin.stats.parents.raw}}">{{boclogin.stats.parents.value}}</strong>
            <small>parents</small>
        </article>
    </section>

    <section class="boc-login-data-strip" aria-label="Live Moodle catalogue summary">
        <span><svg class="boc-login-svg-icon boc-login-data-icon" aria-hidden="true" focusable="false"><use href="#bocIconCourses"></use></svg><strong data-boc-count="{{boclogin.stats.courses.raw}}">{{boclogin.stats.courses.value}}</strong><small>visible courses</small></span>
        <span><svg class="boc-login-svg-icon boc-login-data-icon" aria-hidden="true" focusable="false"><use href="#bocIconCatalogue"></use></svg><strong data-boc-count="{{boclogin.stats.categories.raw}}">{{boclogin.stats.categories.value}}</strong><small>categories</small></span>
        <span><svg class="boc-login-svg-icon boc-login-data-icon" aria-hidden="true" focusable="false"><use href="#bocIconCalendar"></use></svg><strong>2026</strong><small>academic year</small></span>
    </section>

    {{#leftinstructions}}
        <div class="boc-login-instructions">
            {{{leftinstructions}}}
        </div>
    {{/leftinstructions}}
</div>

Option Explicit

Sub AboutMasterImportTools
    MsgBox "Workbook-local macros for the School Master Import workbook." & Chr(10) & _
           "Use GenerateAllDerivedSheets for the normal full rebuild, or run an individual Generate* macro for one derived sheet." & Chr(10) & _
           "Manual registration sheets are not regenerated by these macros.", _
           64, "Master Import Tools"
End Sub

Sub RefreshStatus
    Dim oDoc As Object
    Dim message As String
    On Error GoTo MacroError

    oDoc = ThisComponent
    oDoc.calculateAll()
    message = "Workbook formulas recalculated. Review the status sheet for current PASSED/FAILED checks."

MacroDone:
    MsgBox message, 64, "Master Import Tools"
    Exit Sub

MacroError:
    message = "Status refresh failed: " & Err & " - " & Error$
    Resume MacroDone
End Sub

Sub ClearAutomaticData
    Dim oDoc As Object
    Dim message As String
    On Error GoTo MacroError

    oDoc = ThisComponent
    oDoc.addActionLock()
    oDoc.LockControllers()
    ClearAutomaticSheets oDoc
    oDoc.calculateAll()
    message = "Automatic sheet data cleared. Manual registration and reference sheets were not changed."

MacroDone:
    On Error Resume Next
    oDoc.UnlockControllers()
    oDoc.removeActionLock()
    On Error GoTo 0
    MsgBox message, 64, "Master Import Tools"
    Exit Sub

MacroError:
    message = "Automatic sheet clear failed: " & Err & " - " & Error$
    Resume MacroDone
End Sub

Sub ResetAutomaticData
    Dim oDoc As Object
    Dim message As String
    On Error GoTo MacroError

    oDoc = ThisComponent
    oDoc.addActionLock()
    oDoc.LockControllers()
    ClearAutomaticSheets oDoc
    message = "Automatic sheet data cleared first." & Chr(10) & BuildAllDerivedSheetsMessage(oDoc)

MacroDone:
    On Error Resume Next
    oDoc.UnlockControllers()
    oDoc.removeActionLock()
    On Error GoTo 0
    MsgBox message, 64, "Master Import Tools"
    Exit Sub

MacroError:
    message = "Automatic sheet reset failed: " & Err & " - " & Error$
    Resume MacroDone
End Sub

Sub GenerateAllDerivedSheets
    Dim oDoc As Object
    Dim message As String
    On Error GoTo MacroError

    oDoc = ThisComponent
    oDoc.addActionLock()
    oDoc.LockControllers()

    message = BuildAllDerivedSheetsMessage(oDoc)

MacroDone:
    On Error Resume Next
    oDoc.UnlockControllers()
    oDoc.removeActionLock()
    On Error GoTo 0
    MsgBox message, 64, "Master Import Tools"
    Exit Sub

MacroError:
    message = "Derived sheet generation failed: " & Err & " - " & Error$
    Resume MacroDone
End Sub


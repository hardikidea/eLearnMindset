Function CurrentAcademicYear(oYears As Object) As String
    Dim headerRow As Long, rowIndex As Long, currentValue As String
    headerRow = FindHeaderRow(oYears, "academic_year")
    For rowIndex = headerRow + 1 To LastUsedRow(oYears)
        currentValue = CellText(oYears, FindColumn(oYears, "is_current", headerRow), rowIndex)
        If currentValue = "1" Or LCase(currentValue) = "true" Or LCase(currentValue) = "yes" Then
            CurrentAcademicYear = CellText(oYears, FindColumn(oYears, "academic_year", headerRow), rowIndex)
            Exit Function
        End If
    Next rowIndex
    CurrentAcademicYear = CellText(oYears, FindColumn(oYears, "academic_year", headerRow), headerRow + 1)
End Function

Function CurrentAcademicYearRow(oYears As Object) As Long
    Dim headerRow As Long, rowIndex As Long
    headerRow = FindHeaderRow(oYears, "academic_year")
    For rowIndex = headerRow + 1 To LastUsedRow(oYears)
        If IncludeAcademicYear(oYears, headerRow, rowIndex) Then
            CurrentAcademicYearRow = rowIndex
            Exit Function
        End If
    Next rowIndex
    CurrentAcademicYearRow = headerRow + 1
End Function

Function NextAcademicYear(oYears As Object) As String
    Dim headerRow As Long, rowIndex As Long, foundCurrent As Boolean
    headerRow = FindHeaderRow(oYears, "academic_year")
    For rowIndex = headerRow + 1 To LastUsedRow(oYears)
        If foundCurrent Then
            If CellText(oYears, FindColumn(oYears, "academic_year", headerRow), rowIndex) <> "" Then
                NextAcademicYear = CellText(oYears, FindColumn(oYears, "academic_year", headerRow), rowIndex)
                Exit Function
            End If
        End If
        If IncludeAcademicYear(oYears, headerRow, rowIndex) Then
            foundCurrent = True
        End If
    Next rowIndex
    If LastUsedRow(oYears) > headerRow + 1 Then
        NextAcademicYear = CellText(oYears, FindColumn(oYears, "academic_year", headerRow), headerRow + 2)
    Else
        NextAcademicYear = CurrentAcademicYear(oYears)
    End If
End Function

Function NextAcademicYearRow(oYears As Object) As Long
    Dim headerRow As Long, rowIndex As Long, foundCurrent As Boolean
    headerRow = FindHeaderRow(oYears, "academic_year")
    For rowIndex = headerRow + 1 To LastUsedRow(oYears)
        If foundCurrent Then
            If CellText(oYears, FindColumn(oYears, "academic_year", headerRow), rowIndex) <> "" Then
                NextAcademicYearRow = rowIndex
                Exit Function
            End If
        End If
        If IncludeAcademicYear(oYears, headerRow, rowIndex) Then
            foundCurrent = True
        End If
    Next rowIndex
    If LastUsedRow(oYears) > headerRow + 1 Then
        NextAcademicYearRow = headerRow + 2
    Else
        NextAcademicYearRow = CurrentAcademicYearRow(oYears)
    End If
End Function

Function IncludeAcademicYear(oYears As Object, headerRow As Long, rowIndex As Long) As Boolean
    Dim currentValue As String
    currentValue = CellText(oYears, FindColumn(oYears, "is_current", headerRow), rowIndex)
    IncludeAcademicYear = (currentValue = "1" Or LCase(currentValue) = "true" Or LCase(currentValue) = "yes")
End Function


    If colIndex < 0 Then
        Err.Raise 1301, "MasterImportTools", "Formula header not found: " & headerName & " in " & oSheet.Name
    End If
    FormulaCellByHeader = FormulaCell(oSheet, colIndex, rowIndex)
End Function

Function FormulaCell(oSheet As Object, colIndex As Long, rowIndex As Long) As String
    FormulaCell = "$'" & Replace(oSheet.Name, "'", "''") & "'.$" & ColumnLetters(colIndex) & "$" & CStr(rowIndex + 1)
End Function

Function ColumnLetters(colIndex As Long) As String
    Dim n As Long, result As String, remainder As Long
    n = colIndex + 1
    result = ""
    Do While n > 0
        remainder = (n - 1) Mod 26
        result = Chr(65 + remainder) & result
        n = (n - remainder - 1) \ 26
    Loop
    ColumnLetters = result
End Function

Function FormulaText(value As String) As String
    FormulaText = """" & Replace(value, """", """""") & """"
End Function

Function FormulaStaticText(value As String) As String

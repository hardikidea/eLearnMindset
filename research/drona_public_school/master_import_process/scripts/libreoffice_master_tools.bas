Sub RunBuilder(builderName As String, label As String)
    Dim oDoc As Object
    Dim generatedRows As Long
    Dim message As String
    On Error GoTo MacroError

    oDoc = ThisComponent
    oDoc.addActionLock()
    oDoc.LockControllers()
    generatedRows = BuildByName(oDoc, builderName)
    oDoc.calculateAll()
    message = label & " generated successfully." & Chr(10) & "Rows: " & generatedRows

MacroDone:
    On Error Resume Next
    oDoc.UnlockControllers()
    oDoc.removeActionLock()
    On Error GoTo 0
    MsgBox message, 64, "Master Import Tools"
    Exit Sub

MacroError:
    message = label & " generation failed: " & Err & " - " & Error$
    Resume MacroDone
End Sub

Function BuildByName(oDoc As Object, builderName As String) As Long
    Select Case LCase(builderName)
        Case "grade_subject_matrix"
            BuildByName = BuildGradeSubjectMatrix(oDoc)
        Case "categories"
            BuildByName = BuildCategories(oDoc)
        Case "courses"
            BuildByName = BuildCourses(oDoc)
        Case "courses_with_template_upload"
            BuildByName = BuildCoursesWithTemplateUpload(oDoc)
        Case "cohorts"
            BuildByName = BuildCohorts(oDoc)
        Case "groups"
            BuildByName = BuildGroups(oDoc)
        Case "cohort_members"
            BuildByName = BuildCohortMembers(oDoc)
        Case "enrolments"
            BuildByName = BuildEnrolments(oDoc)
        Case "course_template_application"
            BuildByName = BuildCourseTemplateApplication(oDoc)
        Case "course_certificates"
            BuildByName = BuildCourseCertificates(oDoc)
        Case "course_final_exams"
            BuildByName = BuildCourseFinalExams(oDoc)
        Case "course_term_exams"
            BuildByName = BuildCourseTermExams(oDoc)
        Case "gradebook_weights"
            BuildByName = BuildGradebookWeights(oDoc)
        Case "next_year_courses"
            BuildByName = BuildNextYearCourses(oDoc)
        Case "next_year_cohorts"
            BuildByName = BuildNextYearCohorts(oDoc)
        Case "next_year_groups"
            BuildByName = BuildNextYearGroups(oDoc)
        Case "next_year_enrolments"
            BuildByName = BuildNextYearEnrolments(oDoc)
        Case "alumni_cohorts"
            BuildByName = BuildAlumniCohorts(oDoc)
        Case "optional_year_category_model"
            BuildByName = BuildOptionalYearCategoryModel(oDoc)
        Case "student_academic_history"
            BuildByName = BuildStudentAcademicHistory(oDoc)
        Case "student_promotion_plan"
            BuildByName = BuildStudentPromotionPlan(oDoc)
        Case "assessment_plan"
            BuildByName = BuildAssessmentPlan(oDoc)
        Case "attendance_policy"
            BuildByName = BuildAttendancePolicy(oDoc)
        Case Else
            Err.Raise 1101, "MasterImportTools", "Unknown macro builder: " & builderName
    End Select
End Function

Function BuildGradeSubjectMatrix(oDoc As Object) As Long
    Dim oTarget As Object, oBoards As Object, oMediums As Object
    Dim oGrades As Object, oStreams As Object, oSubjects As Object
    Dim bHeader As Long, mHeader As Long, gHeader As Long, stHeader As Long, suHeader As Long, tHeader As Long
    Dim bLast As Long, mLast As Long, gLast As Long, stLast As Long, suLast As Long
    Dim bRow As Long, mRow As Long, gRow As Long, stRow As Long, suRow As Long
    Dim targetRow As Long, displayOrder As Long, generatedRows As Long
    Dim boardCode As String, mediumCode As String, gradeCode As String, streamCode As String
    Dim appliesTo As String, subjectCode As String, subjectName As String, subjectCategory As String
    Dim sourceNote As String

    oTarget = RequireSheet(oDoc, "13_grade_subject_matrix")
    oBoards = RequireSheet(oDoc, "07_boards")
    oMediums = RequireSheet(oDoc, "08_mediums")
    oGrades = RequireSheet(oDoc, "09_grades")
    oStreams = RequireSheet(oDoc, "10_streams")
    oSubjects = RequireSheet(oDoc, "12_subjects")

    bHeader = FindHeaderRow(oBoards, "board_code")
    mHeader = FindHeaderRow(oMediums, "medium_code")
    gHeader = FindHeaderRow(oGrades, "grade_code")
    stHeader = FindHeaderRow(oStreams, "stream_code")
    suHeader = FindHeaderRow(oSubjects, "subject_code")
    tHeader = FindHeaderRow(oTarget, "board_code")

    bLast = LastUsedRow(oBoards)
    mLast = LastUsedRow(oMediums)
    gLast = LastUsedRow(oGrades)
    stLast = LastUsedRow(oStreams)
    suLast = LastUsedRow(oSubjects)
    targetRow = tHeader + 1
    sourceNote = "Generated by LibreOffice MasterImportTools.GenerateGradeSubjectMatrix. Verify exact board/school subject combinations before Moodle import."

    ClearDataRows oTarget, targetRow
    generatedRows = 0

    For bRow = bHeader + 1 To bLast
        boardCode = CellText(oBoards, FindColumn(oBoards, "board_code", bHeader), bRow)
        If boardCode <> "" Then
            For mRow = mHeader + 1 To mLast
                mediumCode = CellText(oMediums, FindColumn(oMediums, "medium_code", mHeader), mRow)
                If mediumCode <> "" Then
                    For gRow = gHeader + 1 To gLast
                        gradeCode = CellText(oGrades, FindColumn(oGrades, "grade_code", gHeader), gRow)
                        If gradeCode <> "" Then
                            For stRow = stHeader + 1 To stLast
                                streamCode = CellText(oStreams, FindColumn(oStreams, "stream_code", stHeader), stRow)
                                appliesTo = CellText(oStreams, FindColumn(oStreams, "applies_to", stHeader), stRow)
                                If streamCode <> "" And StreamAppliesToGrade(gradeCode, streamCode, appliesTo) Then
                                    displayOrder = 1
                                    For suRow = suHeader + 1 To suLast
                                        subjectCode = CellText(oSubjects, FindColumn(oSubjects, "subject_code", suHeader), suRow)
                                        subjectName = CellText(oSubjects, FindColumn(oSubjects, "subject_name", suHeader), suRow)
                                        subjectCategory = CellText(oSubjects, FindColumn(oSubjects, "subject_category", suHeader), suRow)
                                        If SubjectAllowedForGradeStream(gradeCode, streamCode, subjectCode, subjectCategory) Then
                                            SetFormulaByHeader oTarget, tHeader, targetRow, "board_code", "=" & FormulaCellByHeader(oBoards, bHeader, bRow, "board_code")
                                            SetFormulaByHeader oTarget, tHeader, targetRow, "medium_code", "=" & FormulaCellByHeader(oMediums, mHeader, mRow, "medium_code")
                                            SetFormulaByHeader oTarget, tHeader, targetRow, "grade_code", "=" & FormulaCellByHeader(oGrades, gHeader, gRow, "grade_code")
                                            SetFormulaByHeader oTarget, tHeader, targetRow, "stream_code", "=" & FormulaCellByHeader(oStreams, stHeader, stRow, "stream_code")
                                            SetFormulaByHeader oTarget, tHeader, targetRow, "subject_code", "=" & FormulaCellByHeader(oSubjects, suHeader, suRow, "subject_code")
                                            SetFormulaByHeader oTarget, tHeader, targetRow, "subject_name", "=" & FormulaCellByHeader(oSubjects, suHeader, suRow, "subject_name")
                                            SetFormulaByHeader oTarget, tHeader, targetRow, "subject_category", "=" & FormulaCellByHeader(oSubjects, suHeader, suRow, "subject_category")
                                            SetFormulaByHeader oTarget, tHeader, targetRow, "is_compulsory", FormulaStaticText("1")
                                            SetFormulaByHeader oTarget, tHeader, targetRow, "is_elective", FormulaStaticText("0")
                                            SetFormulaByHeader oTarget, tHeader, targetRow, "display_order", FormulaStaticText(CStr(displayOrder))
                                            SetFormulaByHeader oTarget, tHeader, targetRow, "source_note", FormulaStaticText(sourceNote)
                                            targetRow = targetRow + 1
                                            displayOrder = displayOrder + 1
                                            generatedRows = generatedRows + 1
                                        End If
                                    Next suRow
                                End If
                            Next stRow
                        End If
                    Next gRow
                End If
            Next mRow
        End If
    Next bRow
    BuildGradeSubjectMatrix = generatedRows
End Function

Function BuildCategories(oDoc As Object) As Long
    Dim oTarget As Object, oSchool As Object, oBoards As Object, oYears As Object
    Dim oMediums As Object, oGrades As Object, oStreams As Object
    Dim hTarget As Long, hSchool As Long, hBoard As Long, hYear As Long, hMedium As Long, hGrade As Long, hStream As Long
    Dim targetRow As Long, bRow As Long, yRow As Long, mRow As Long, gRow As Long, sRow As Long
    Dim trustCode As String, trustName As String, schoolCode As String, schoolName As String
    Dim boardCode As String, boardName As String, academicYear As String
    Dim mediumCode As String, mediumName As String, gradeCode As String, gradeName As String
    Dim streamCode As String, streamName As String, appliesTo As String
    Dim boardCategory As String, schoolCategory As String, yearCategory As String
    Dim mediumCategory As String, gradeCategory As String, streamCategory As String
    Dim basePath As String, pathText As String, generatedRows As Long
    Dim trustCodeRef As String, trustNameRef As String, schoolCodeRef As String, schoolNameRef As String
    Dim boardCodeRef As String, boardNameRef As String, yearRef As String
    Dim mediumCodeRef As String, mediumNameRef As String, gradeCodeRef As String, gradeNameRef As String
    Dim streamCodeRef As String, streamNameRef As String
    Dim boardCategoryFormula As String, schoolCategoryFormula As String, yearCategoryFormula As String
    Dim mediumCategoryFormula As String, gradeCategoryFormula As String, streamCategoryFormula As String
    Dim basePathFormula As String, pathFormula As String

    oTarget = RequireSheet(oDoc, "14_categories")
    oSchool = RequireSheet(oDoc, "05_school_master")
    oBoards = RequireSheet(oDoc, "07_boards")
    oYears = RequireSheet(oDoc, "06_academic_years")
    oMediums = RequireSheet(oDoc, "08_mediums")
    oGrades = RequireSheet(oDoc, "09_grades")
    oStreams = RequireSheet(oDoc, "10_streams")

    hTarget = FindHeaderRow(oTarget, "category_code")
    hSchool = FindHeaderRow(oSchool, "trust_code")
    hBoard = FindHeaderRow(oBoards, "board_code")
    hYear = FindHeaderRow(oYears, "academic_year")
    hMedium = FindHeaderRow(oMediums, "medium_code")
    hGrade = FindHeaderRow(oGrades, "grade_code")
    hStream = FindHeaderRow(oStreams, "stream_code")

    targetRow = hTarget + 1
    ClearDataRows oTarget, targetRow
    generatedRows = 0

    trustCode = CellText(oSchool, FindColumn(oSchool, "trust_code", hSchool), hSchool + 1)
    trustName = CellText(oSchool, FindColumn(oSchool, "trust_name", hSchool), hSchool + 1)
    schoolCode = CellText(oSchool, FindColumn(oSchool, "school_code", hSchool), hSchool + 1)
    schoolName = CellText(oSchool, FindColumn(oSchool, "school_name", hSchool), hSchool + 1)
    trustCodeRef = FormulaCellByHeader(oSchool, hSchool, hSchool + 1, "trust_code")
    trustNameRef = FormulaCellByHeader(oSchool, hSchool, hSchool + 1, "trust_name")
    schoolCodeRef = FormulaCellByHeader(oSchool, hSchool, hSchool + 1, "school_code")
    schoolNameRef = FormulaCellByHeader(oSchool, hSchool, hSchool + 1, "school_name")
    If trustCode = "" Or schoolCode = "" Then Err.Raise 1201, "MasterImportTools", "05_school_master requires trust_code and school_code."

    WriteCategory oTarget, hTarget, targetRow, "=" & trustCodeRef, FormulaBlank(), FormulaStaticText("trust"), "=" & trustNameRef, "=" & trustCodeRef, "=" & trustNameRef, FormulaStaticText("1"), FormulaStaticText("Root trust category.")
    targetRow = targetRow + 1
    generatedRows = generatedRows + 1

    For bRow = hBoard + 1 To LastUsedRow(oBoards)
        boardCode = CellText(oBoards, FindColumn(oBoards, "board_code", hBoard), bRow)
        boardName = CellText(oBoards, FindColumn(oBoards, "board_name", hBoard), bRow)
        If boardCode <> "" Then
            boardCodeRef = FormulaCellByHeader(oBoards, hBoard, bRow, "board_code")
            boardNameRef = FormulaCellByHeader(oBoards, hBoard, bRow, "board_name")
            boardCategory = trustCode & "_" & boardCode
            schoolCategory = boardCategory & "_" & schoolCode
            boardCategoryFormula = "=" & trustCodeRef & "&" & FormulaText("_") & "&" & boardCodeRef
            schoolCategoryFormula = "=" & trustCodeRef & "&" & FormulaText("_") & "&" & boardCodeRef & "&" & FormulaText("_") & "&" & schoolCodeRef
            WriteCategory oTarget, hTarget, targetRow, boardCategoryFormula, "=" & trustCodeRef, FormulaStaticText("board"), "=" & boardNameRef, boardCategoryFormula, "=" & trustNameRef & "&" & FormulaText(" / ") & "&" & boardNameRef, FormulaStaticText("1"), FormulaStaticText("Board category.")
            targetRow = targetRow + 1
            generatedRows = generatedRows + 1
            WriteCategory oTarget, hTarget, targetRow, schoolCategoryFormula, boardCategoryFormula, FormulaStaticText("school"), "=" & schoolNameRef, schoolCategoryFormula, "=" & trustNameRef & "&" & FormulaText(" / ") & "&" & boardNameRef & "&" & FormulaText(" / ") & "&" & schoolNameRef, FormulaStaticText("1"), FormulaStaticText("School category.")
            targetRow = targetRow + 1
            generatedRows = generatedRows + 1

            For yRow = hYear + 1 To LastUsedRow(oYears)
                academicYear = CellText(oYears, FindColumn(oYears, "academic_year", hYear), yRow)
                If academicYear <> "" And IncludeAcademicYear(oYears, hYear, yRow) Then
                    yearRef = FormulaCellByHeader(oYears, hYear, yRow, "academic_year")
                    yearCategory = schoolCategory & "_" & YearToken(academicYear)
                    basePath = trustName & " / " & boardName & " / " & schoolName & " / Academic Year " & academicYear
                    yearCategoryFormula = schoolCategoryFormula & "&" & FormulaText("_") & "&SUBSTITUTE(" & yearRef & ";" & FormulaText("-") & ";" & FormulaText("_") & ")"
                    basePathFormula = "=" & trustNameRef & "&" & FormulaText(" / ") & "&" & boardNameRef & "&" & FormulaText(" / ") & "&" & schoolNameRef & "&" & FormulaText(" / Academic Year ") & "&" & yearRef
                    WriteCategory oTarget, hTarget, targetRow, yearCategoryFormula, schoolCategoryFormula, FormulaStaticText("academic_year"), "=" & FormulaText("Academic Year ") & "&" & yearRef, yearCategoryFormula, basePathFormula, FormulaStaticText("1"), "=" & FormulaText("Academic year ") & "&" & yearRef & "&" & FormulaText(".")
                    targetRow = targetRow + 1
                    generatedRows = generatedRows + 1

                    For mRow = hMedium + 1 To LastUsedRow(oMediums)
                        mediumCode = CellText(oMediums, FindColumn(oMediums, "medium_code", hMedium), mRow)
                        mediumName = CellText(oMediums, FindColumn(oMediums, "medium_name", hMedium), mRow)
                        If mediumCode <> "" Then
                            mediumCodeRef = FormulaCellByHeader(oMediums, hMedium, mRow, "medium_code")
                            mediumNameRef = FormulaCellByHeader(oMediums, hMedium, mRow, "medium_name")
                            mediumCategory = yearCategory & "_" & mediumCode
                            mediumCategoryFormula = yearCategoryFormula & "&" & FormulaText("_") & "&" & mediumCodeRef
                            WriteCategory oTarget, hTarget, targetRow, mediumCategoryFormula, yearCategoryFormula, FormulaStaticText("medium"), "=" & mediumNameRef, mediumCategoryFormula, basePathFormula & "&" & FormulaText(" / ") & "&" & mediumNameRef, FormulaStaticText("1"), "=" & mediumNameRef & "&" & FormulaText(" category for ") & "&" & yearRef & "&" & FormulaText(".")
                            targetRow = targetRow + 1
                            generatedRows = generatedRows + 1

                            For gRow = hGrade + 1 To LastUsedRow(oGrades)
                                gradeCode = CellText(oGrades, FindColumn(oGrades, "grade_code", hGrade), gRow)
                                gradeName = CellText(oGrades, FindColumn(oGrades, "grade_name", hGrade), gRow)
                                If gradeCode <> "" Then
                                    gradeCodeRef = FormulaCellByHeader(oGrades, hGrade, gRow, "grade_code")
                                    gradeNameRef = FormulaCellByHeader(oGrades, hGrade, gRow, "grade_name")
                                    gradeCategory = mediumCategory & "_" & gradeCode
                                    pathText = basePath & " / " & mediumName & " / " & gradeName
                                    gradeCategoryFormula = mediumCategoryFormula & "&" & FormulaText("_") & "&" & gradeCodeRef
                                    pathFormula = basePathFormula & "&" & FormulaText(" / ") & "&" & mediumNameRef & "&" & FormulaText(" / ") & "&" & gradeNameRef
                                    WriteCategory oTarget, hTarget, targetRow, gradeCategoryFormula, mediumCategoryFormula, FormulaStaticText("grade"), "=" & gradeNameRef, gradeCategoryFormula, pathFormula, FormulaStaticText("1"), "=" & gradeNameRef & "&" & FormulaText(" category.")
                                    targetRow = targetRow + 1
                                    generatedRows = generatedRows + 1

                                    For sRow = hStream + 1 To LastUsedRow(oStreams)
                                        streamCode = CellText(oStreams, FindColumn(oStreams, "stream_code", hStream), sRow)
                                        streamName = CellText(oStreams, FindColumn(oStreams, "stream_name", hStream), sRow)
                                        appliesTo = CellText(oStreams, FindColumn(oStreams, "applies_to", hStream), sRow)
                                        If streamCode <> "" And StreamAppliesToGrade(gradeCode, streamCode, appliesTo) Then
                                            streamCodeRef = FormulaCellByHeader(oStreams, hStream, sRow, "stream_code")
                                            streamNameRef = FormulaCellByHeader(oStreams, hStream, sRow, "stream_name")
                                            streamCategory = gradeCategory & "_" & streamCode
                                            streamCategoryFormula = gradeCategoryFormula & "&" & FormulaText("_") & "&" & streamCodeRef
                                            WriteCategory oTarget, hTarget, targetRow, streamCategoryFormula, gradeCategoryFormula, FormulaStaticText("stream"), "=" & streamNameRef, streamCategoryFormula, pathFormula & "&" & FormulaText(" / ") & "&" & streamCodeRef, FormulaStaticText("1"), "=" & streamNameRef & "&" & FormulaText(" stream category.")
                                            targetRow = targetRow + 1
                                            generatedRows = generatedRows + 1
                                        End If
                                    Next sRow
                                End If
                            Next gRow
                        End If
                    Next mRow
                End If
            Next yRow
        End If
    Next bRow

    WriteCategory oTarget, hTarget, targetRow, FormulaStaticText("COURSE_TEMPLATES"), FormulaBlank(), FormulaStaticText("system"), FormulaStaticText("Course Templates"), FormulaStaticText("COURSE_TEMPLATES"), FormulaStaticText("Course Templates"), FormulaStaticText("1"), FormulaStaticText("Hidden reusable course templates.")
    BuildCategories = generatedRows + 1
End Function

Function BuildCourses(oDoc As Object) As Long
    Dim oTarget As Object, oMatrix As Object, oSchool As Object, oYears As Object, oBoards As Object, oMediums As Object, oGrades As Object
    Dim hTarget As Long, hMatrix As Long, hSchool As Long, hYear As Long, hBoard As Long, hMedium As Long, hGrade As Long
    Dim targetRow As Long, mRow As Long, yearRow As Long
    Dim schoolCode As String, schoolName As String, trustCode As String, academicYear As String
    Dim boardCode As String, boardName As String, mediumCode As String, mediumName As String

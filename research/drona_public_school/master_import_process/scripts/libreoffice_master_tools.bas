Function LookupInSheet(oSheet As Object, keyHeader As String, keyValue As String, returnHeader As String) As String
    Dim headerRow As Long, keyCol As Long, valueCol As Long, rowIndex As Long
    headerRow = FindHeaderRow(oSheet, keyHeader)
    keyCol = FindColumn(oSheet, keyHeader, headerRow)
    valueCol = FindColumn(oSheet, returnHeader, headerRow)
    For rowIndex = headerRow + 1 To LastUsedRow(oSheet)
        If CellText(oSheet, keyCol, rowIndex) = keyValue Then
            LookupInSheet = CellText(oSheet, valueCol, rowIndex)
            Exit Function
        End If
    Next rowIndex
    LookupInSheet = ""
End Function


Function RequireSheet(oDoc As Object, sheetName As String) As Object
    If Not oDoc.Sheets.hasByName(sheetName) Then
        Err.Raise 1001, "MasterImportTools", "Missing worksheet: " & sheetName
    End If
    RequireSheet = oDoc.Sheets.getByName(sheetName)
End Function

Function LastUsedRow(oSheet As Object) As Long
    Dim cursor As Object
    cursor = oSheet.createCursor()
    cursor.gotoEndOfUsedArea(True)
    LastUsedRow = cursor.RangeAddress.EndRow
End Function

Function LastUsedColumn(oSheet As Object) As Long
    Dim cursor As Object
    cursor = oSheet.createCursor()
    cursor.gotoEndOfUsedArea(True)
    LastUsedColumn = cursor.RangeAddress.EndColumn
End Function

Function FindHeaderRow(oSheet As Object, headerName As String) As Long
    Dim rowIndex As Long, colIndex As Long, lastCol As Long
    lastCol = LastUsedColumn(oSheet)
    For rowIndex = 0 To 9
        For colIndex = 0 To lastCol
            If LCase(Trim(oSheet.getCellByPosition(colIndex, rowIndex).String)) = LCase(headerName) Then
                FindHeaderRow = rowIndex
                Exit Function
            End If
        Next colIndex
    Next rowIndex
    Err.Raise 1002, "MasterImportTools", "Header not found: " & headerName & " in " & oSheet.Name
End Function

Function FindColumn(oSheet As Object, headerName As String, headerRow As Long) As Long
    Dim colIndex As Long, lastCol As Long
    lastCol = LastUsedColumn(oSheet)
    For colIndex = 0 To lastCol
        If LCase(Trim(oSheet.getCellByPosition(colIndex, headerRow).String)) = LCase(headerName) Then
            FindColumn = colIndex
            Exit Function
        End If
    Next colIndex
    FindColumn = -1
End Function

Function CellText(oSheet As Object, colIndex As Long, rowIndex As Long) As String
    If colIndex < 0 Then
        CellText = ""
    Else
        CellText = Trim(oSheet.getCellByPosition(colIndex, rowIndex).String)
    End If
End Function

Sub ClearDataRows(oSheet As Object, startRow As Long)
    Dim lastRow As Long, lastCol As Long
    lastRow = LastUsedRow(oSheet)
    lastCol = LastUsedColumn(oSheet)
    If lastRow >= startRow And lastCol >= 0 Then
        oSheet.getCellRangeByPosition(0, startRow, lastCol, lastRow).clearContents(1023)
    End If
End Sub

Function FirstHeaderRow(oSheet As Object) As Long
    Dim rowIndex As Long
    For rowIndex = 0 To 9
        If Trim(oSheet.getCellByPosition(0, rowIndex).String) <> "" Then
            FirstHeaderRow = rowIndex
            Exit Function
        End If
    Next rowIndex
    Err.Raise 1003, "MasterImportTools", "Header row not found in " & oSheet.Name
End Function

